{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/events/:slug",
            "destination": "/api/index.js"
        },
        {
            "source": "/events/:slug.md",
            "destination": "/api/index.js"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/index.js"
        },
        {
            "source": "/llms.txt",
            "destination": "/api/index.js"
        }
    ],
    "redirects": [
        {
            "source": "/server.js",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/api/index.js",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/package.json",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/package-lock.json",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/.env",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/.env.local",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/.env.(.*)",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/.git/(.*)",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/.vercel/(.*)",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/appletree-run/wp-content/uploads/sites/6/2023/08/modified-Appletree_Logo_23Final-003.png",
            "destination": "/images/logos/appletree-marathon.png",
            "permanent": true
        },
        {
            "source": "/girlfriends-run/:path*",
            "destination": "/events/girlfriends-half-marathon-10k-6k",
            "permanent": true
        },
        {
            "source": "/scary-run/:path*",
            "destination": "/events/scary-run",
            "permanent": true
        },
        {
            "source": "/scary-run-half-marathon-10k-5k/:path*",
            "destination": "/events/scary-run",
            "permanent": true
        },
        {
            "source": "/couve-clover-run/:path*",
            "destination": "/events/couve-clover-run",
            "permanent": true
        },
        {
            "source": "/springclassic/:path*",
            "destination": "/events/spring-classic-duathlon-half-marathon-10k-5k",
            "permanent": true
        },
        {
            "source": "/spring-classic-duathlon/:path*",
            "destination": "/events/spring-classic-duathlon-half-marathon-10k-5k",
            "permanent": true
        },
        {
            "source": "/reflection-run/:path*",
            "destination": "/events/reflection-run",
            "permanent": true
        },
        {
            "source": "/pdx-triathlon/:path*",
            "destination": "/events/pdx-triathlon-festival",
            "permanent": true
        },
        {
            "source": "/pdx-triathlon-at-blue-lake/:path*",
            "destination": "/events/pdx-triathlon-festival",
            "permanent": true
        },
        {
            "source": "/columbia-river-triathlon/:path*",
            "destination": "/events/columbia-river-triathlon-endurance-sports-festival",
            "permanent": true
        },
        {
            "source": "/girlfriends-triathlon-fitness-festival/:path*",
            "destination": "/events/girlfriends-all-women-s-triathlon-fitness-festival",
            "permanent": true
        },
        {
            "source": "/appletree-marathon/:path*",
            "destination": "/events/appletree-marathon",
            "permanent": true
        },
        {
            "source": "/appletree-run/:path*",
            "destination": "/events/appletree-marathon",
            "permanent": true
        },
        {
            "source": "/pacific-coast-running-festival/:path*",
            "destination": "/events/pacific-coast-running-festival",
            "permanent": true
        },
        {
            "source": "/hagg-lake-triathlon/:path*",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/pacific-crest-endurance/:path*",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/events",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/events/",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/training-programs/:path*",
            "destination": "/pages/training.html",
            "permanent": true
        },
        {
            "source": "/partnership-opportunities/:path*",
            "destination": "/pages/partners.html",
            "permanent": true
        },
        {
            "source": "/contact/:path*",
            "destination": "/pages/about.html",
            "permanent": true
        },
        {
            "source": "/athlete-of-the-month/:path*",
            "destination": "/pages/community.html",
            "permanent": true
        },
        {
            "source": "/blog/:path*",
            "destination": "/pages/community.html",
            "permanent": true
        },
        {
            "source": "/triathlon-duathlon-awards-series/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/merchandise/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/products/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/products-2/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/collections/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/collections-2/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/contest/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/race-home-test/:path*",
            "destination": "/",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
                },
                {
                    "key": "X-DNS-Prefetch-Control",
                    "value": "on"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.supabase.co https://whyracingevents.com https://images.unsplash.com; media-src 'self' https://*.supabase.co; connect-src 'self' https://*.supabase.co https://*.ingest.sentry.io; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; report-uri /api/csp-report"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ]
        },
        {
            "source": "/videos/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ]
        },
        {
            "source": "/pages/admin/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, private"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/cron/export-signups",
            "schedule": "0 16 * * 1"
        },
        {
            "path": "/api/cron/archive-races",
            "schedule": "0 0 * * *"
        }
    ]
}
